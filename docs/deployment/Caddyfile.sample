# Full Caddyfile template for a BirdNET-Pi + Bird Up! deployment.
# Keeps the live collage public; only the admin menu/tools are password-protected.
#
# 1. Generate a bcrypt hash for your admin username:
#      caddy hash-password --plaintext 'your-pass'
# 2. Replace the hash below with your own.
# 3. Copy this file to /etc/caddy/Caddyfile and run `sudo caddy reload`.

{
	admin 127.0.0.1:2019
	# Built-in Prometheus metrics (served on the admin endpoint /metrics).
	# Not reachable from the LAN — the :2020 site below proxies only /metrics.
	metrics
}

# Prometheus scrape target for Caddy's own metrics (job birdup-caddy in the
# homelab repo). Exposes ONLY the admin /metrics path; the admin API itself
# stays loopback-bound. The cluster scrapes <PI_IP>:2020.
:2020 {
	handle /metrics {
		reverse_proxy 127.0.0.1:2019 {
			# Admin endpoint validates Host against its origins list.
			header_up Host 127.0.0.1:2019
		}
	}
}

# (php-fpm status needs no HTTP route: the php-fpm exporter reads pool status
# over the FastCGI unix socket — pm.status_path=/status on the pool.)

http:// {
	# JSON access log for mtail (:3903) — see avian/mic-node/caddy-logs.mtail.
	log {
		output file /var/log/caddy/access.log
		format json
	}
	root * /home/YOUR_USER/BirdSongs/Extracted
	file_server browse
	handle /By_Date/* {
		file_server browse
	}
	handle /Charts/* {
		file_server browse
	}
	# OTA server for the T-SIM7080G wireless mic node. Public static files
	# (firmware .bin + ota-version.txt + .md5) served from
	# ~/BirdNET-Pi/avian/ota/ - the node's firmware updater fetches these
	# unauthenticated over the LAN. Written by the admin UI via
	# /avian/api/ota-server.php (session-protected).
	handle /avian/ota/* {
		file_server
	}
	reverse_proxy /stream localhost:8000
	php_fastcgi unix//run/php/php8.4-fpm.sock {
		env HTTP_AUTHORIZATION {http.request.header.Authorization}
		env AV_REQUIRE_AUTH 1
		try_files {path} {path}/index.html {path}/index.php index.php
	}

	# Don't let browsers or CDNs cache the HTML shell.
	header / Cache-Control "no-cache, no-store, must-revalidate"
	header *.html Cache-Control "no-cache, no-store, must-revalidate"

	# Bundled bird images are served statically now (apt.js resolves DIMS
	# keys to /avian/assets/illustrations/<slug>.png directly, bypassing
	# cutout.php). Cache them for a day like serve_png() did; re-renders
	# bust the cache via the ?v=SKETCH_VERSION/IMG_VERSION query param.
	header /avian/assets/* Cache-Control "public, max-age=86400"

	# Admin/tools password protection. The collage and public bird cards
	# stay open; only the menu unlock and backend admin endpoints require
	# the password.
	@admin {
		path /avian/api/menu.php
		path /avian/api/config.php
		path /avian/api/birdnet-status.php
		path /avian/api/correction.php
		path /log*
		path /stats*
		path /terminal*
	}
	basic_auth @admin {
		# Generate with: caddy hash-password --plaintext 'your-pass'
		birdnet $2a$14$REPLACE_WITH_HASH_FROM_caddy_hash-password
	}

	reverse_proxy /log* localhost:8080
	reverse_proxy /stats* localhost:8501
	reverse_proxy /terminal* localhost:8888
}
